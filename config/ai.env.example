# Copy values into the server's secret environment. Never commit real keys.
AI_TEXT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_OUTPUT_TOKENS=16384
CLAUDE_EFFORT=medium

# Gemini is used for images only. Set disabled to opt out. No real key belongs here.
AI_IMAGE_PROVIDER=gemini
AI_IMAGE_PROVIDER_APPROVED=true
AI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_API_KEY=
GOOGLE_IMAGE_RESOLUTION=1K
GOOGLE_IMAGE_CONCURRENCY=2
AI_IMAGE_API_KEY=
# Optional Claude vision inspection: at most one Gemini image per request.
AI_IMAGE_SEMANTIC_REVIEW=false
AI_IMAGE_ESTIMATED_UNIT_COST=0.06
AI_IMAGE_MAX_ESTIMATED_COST=0.18
PRESENTATION_ALLOW_IMAGE_GENERATION=true
WEBPAGE_ALLOW_IMAGE_GENERATION=true
DOCUMENT_ALLOW_IMAGE_GENERATION=true
WEBPAGE_IMAGE_MAX_GENERATED=2
WEBPAGE_IMAGE_TIMEOUT_MS=30000
WEBPAGE_IMAGE_TOTAL_MS=60000
WEBPAGE_IMAGE_RETRIES=0
WEBPAGE_IMAGE_SUBJECT_COVERAGE_MIN=0.3

LEDIFY_GENERATION_CONCURRENCY=2
LEDIFY_AI_CONCURRENCY=6
PRESENTATION_QUALITY_MAX_REPAIR_ROUNDS=1
PRESENTATION_QUALITY_MAX_REPAIRED_SLIDES=4
# Optional private directory for actual review responses; never serve it publicly.
# PRESENTATION_QUALITY_AUDIT_DIR=/private/ledify-quality-audits
LEDIFY_SLIDE_CONCURRENCY=6
LEDIFY_RENDER_CONCURRENCY=1

# Disabled rollback only. Selecting this requires an explicit operator action;
# Anthropic or dedicated-image failures never activate it automatically.
AI_ALLOW_GOOGLE_ROLLBACK=false

# AI-directed design; legacy disables the additive design compiler boundary.
LEDIFY_DESIGN_ENGINE=2.0
LEDIFY_VISUAL_REVIEW=false
LEDIFY_RETAIN_QA_ARTIFACTS=false
# Pexels is first when a registered API key is supplied. Credits are retained.
PEXELS_API_KEY=
PRESENTATION_STOCK_PROVIDER=auto
# Optional second stock search source; each result must have an allowed license.
OPENVERSE_ENABLED=false
OPENVERSE_ACCESS_TOKEN=
# Optional paid text-model vision call: at most one ambiguous selected scene.
AI_STOCK_SEMANTIC_REVIEW=false

# URL retrieval and understanding share one overall deadline, not stacked waits.
URL_EXTRACTION_TOTAL_MS=35000
# Overall processing budget, including input preparation; separate from URL stages.
# Cooperative cancellation stops AI/queues immediately and checks other stages on return.
LEDIFY_GENERATION_TIMEOUT_MS=600000
URL_RETRIEVAL_MS=12000
URL_DIRECT_MS=8000
URL_SOURCE_API_MS=8000
URL_UNDERSTANDING_MS=30000
URL_UNDERSTANDING_MAX_CHARACTERS=24000
# The existing planner can consume full validated text if optional analysis fails.
URL_UNDERSTANDING_REQUIRED=false
URL_WEB_FETCH_MS=8000
# Optional bounded in-memory cache for public Wikipedia articles only (0–300s).
URL_PUBLIC_CACHE_SECONDS=0

# Default concurrent acquisition: all configured Commons/Unsplash/Picsum/Gemini/
# Pixabay contenders begin together. False retains the old rollback path only.
IMAGE_RACE_ENABLED=true
UNSPLASH_ACCESS_KEY=
# Standard Unsplash API hotlinking does not cover Ledify's bundled exports.
# Set true only with documented Unsplash permission for this exact use.
UNSPLASH_BUNDLED_EXPORT_APPROVED=false
PIXABAY_API_KEY=
PIXABAY_REQUESTS_PER_MINUTE=90
# Pixabay metadata is stored for 24h; photos are bundled, never permanently hotlinked.
# PIXABAY_CACHE_DIR=/persistent/ledify/pixabay-metadata
# Picsum cannot win without actual Claude pixel review and source licensing checks.
IMAGE_RACE_MAX_VISION_REVIEWS=4
# Concurrent Gemini submissions can cost money even when another source wins.
# Existing AI_IMAGE_PROVIDER=gemini / AI_IMAGE_PROVIDER_APPROVED=true,
# GEMINI_API_KEY, per-output generation flags and positive cost budgets still apply.
# Preferred AI_IMAGE_MODEL=gemini-nano-banana-2.1; GOOGLE_IMAGE_CONCURRENCY bounds work.
# Native fetch is a separately enabled fallback using the SAME Claude model.
# Populate exact trusted public hostnames before enabling. No search fallback.
URL_CLAUDE_WEB_FETCH_ENABLED=false
URL_CLAUDE_WEB_FETCH_DOMAINS=
LEDIFY_SOURCE_USER_AGENT=Ledify-SourceReader/2.0 (https://ledify-frontend.vercel.app/)
